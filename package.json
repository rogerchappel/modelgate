{
  "name": "modelgate-cli",
  "version": "0.1.0",
  "description": "Local-first LLM route, fallback, and budget inspector for agent/developer workflows.",
  "type": "module",
  "bin": {
    "modelgate": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "examples",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "fixtures/sample"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "package:identity": "node scripts/check-package-identity.mjs",
    "release:contract": "node scripts/check-release-contract.mjs",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release:check": "npm run package:identity && npm run release:contract && npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "llm",
    "gateway",
    "cost-estimation",
    "fallbacks",
    "local-first",
    "cli",
    "agents"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/modelgate.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/modelgate/issues"
  },
  "homepage": "https://github.com/rogerchappel/modelgate#readme",
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
